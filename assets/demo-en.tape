Output assets/limitdeck-en.gif

Set Shell "bash"
Set Theme "Dracula"
Set FontSize 18
Set Width 1000
Set Height 360
Set Framerate 15
Set TypingSpeed 0ms
Set Padding 16

Hide
Type "rm -rf /tmp/limitdeck-readme-en && env -u NO_COLOR LC_ALL=C XDG_CONFIG_HOME=/tmp/limitdeck-readme-en TERM=xterm-256color target/release/limitdeck"
Enter
Sleep 5s
Type "s"
Sleep 1s
Enter
Sleep 1s
Show
Screenshot assets/screenshots/detail-en.png
Sleep 3s
Escape
Sleep 1500ms
Screenshot assets/screenshots/quotas-en.png
Sleep 2500ms
Type "m"
Sleep 2s
Screenshot assets/screenshots/models-30d-en.png
Sleep 2500ms
Type "f"
Sleep 2s
Screenshot assets/screenshots/models-all-en.png
Sleep 2s
Type "?"
Sleep 2s
Screenshot assets/screenshots/help-en.png
Sleep 3s
Type "q"
Sleep 500ms
Hide
Type "rm -rf /tmp/limitdeck-readme-en"
Enter
